modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Local PostgreSQL 16"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "PLFE foundation worker"

[[workflows.workflow]]
name = "Local PostgreSQL 16"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "postgres -D /home/runner/workspace/artifacts/plfe/var/postgres -h 127.0.0.1 -p 55432 -k /tmp"

[[workflows.workflow]]
name = "PLFE foundation worker"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run worker"

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.development]
PLFE_DATABASE_URL = "postgresql://runner@127.0.0.1:55432/plfe?schema=public"
SEED_OWNER_EMAIL = "owner@plfe.local"
SEED_OWNER_NAME = "System Owner"
TEST_DATABASE_URL = "postgresql://runner@127.0.0.1:55432/plfe_test?schema=public"
