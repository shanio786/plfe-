generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id               String    @id @default(uuid()) @db.Uuid
  code             String    @db.VarChar(30)
  name             String    @db.VarChar(200)
  legalName        String    @map("legal_name") @db.VarChar(250)
  ntn              String?
  strn             String?
  address          String?
  phone            String?
  email            String?
  logoAttachmentId String?   @map("logo_attachment_id") @db.Uuid
  currency         String    @db.Char(3)
  fyStartMonth     Int       @map("fy_start_month")
  lockDate         DateTime? @map("lock_date") @db.Date
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy        String?   @map("created_by") @db.Uuid
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy        String?   @map("updated_by") @db.Uuid
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)
  branches         Branch[]
  departments      Department[]
  accounts         Account[]
  parties          Party[]
  journals         Journal[]
  entries          JournalEntry[]
  journalLines     JournalLine[]
  invoices         Invoice[]
  invoiceLines     InvoiceLine[]
  bills            Bill[]
  billLines        BillLine[]
  payments         Payment[]
  allocations      PaymentAllocation[]
  accountingSettings AccountingSettings[]
  roles            Role[]
  memberships      UserCompanyRole[]
  rolePermissions  RolePermission[]
  fiscalYears      FiscalYear[]
  periods          Period[]
  series           NumberSeries[]
  sequences        Sequence[]
  approvalRules    ApprovalRule[]
  approvals        Approval[]
  attachments      Attachment[]
  auditLogs        AuditLog[]
  @@map("companies")
}

model User {
  id                       String    @id @default(uuid()) @db.Uuid
  name                     String
  email                    String
  passwordHash             String    @map("password_hash")
  phone                    String?
  photoStorageKey          String?   @map("photo_storage_key")
  active                   Boolean   @default(true)
  isOwner                  Boolean   @default(false) @map("is_owner")
  mustChangePassword       Boolean   @default(true) @map("must_change_password")
  failedLogins             Int       @default(0) @map("failed_logins")
  lockedUntil              DateTime? @map("locked_until") @db.Timestamptz(6)
  passwordChangedAt        DateTime? @map("password_changed_at") @db.Timestamptz(6)
  lastLoginAt              DateTime? @map("last_login_at") @db.Timestamptz(6)
  twoFactorEnabled         Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecretEncrypted String?   @map("two_factor_secret_encrypted")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy                String?   @map("created_by") @db.Uuid
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy                String?   @map("updated_by") @db.Uuid
  deletedAt                DateTime? @map("deleted_at") @db.Timestamptz(6)
  memberships              UserCompanyRole[]
  sessions                 Session[]
  auditLogs                AuditLog[]
  uploads                  Attachment[]
  requests                 Approval[] @relation("Requester")
  decisions                Approval[] @relation("Decider")
  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  ip        String?  @db.VarChar(45)
  device    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields:[userId],references:[id],onDelete:Restrict)
  @@index([userId, expiresAt])
  @@map("sessions")
}

model Branch {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  code      String
  name      String
  type      String
  address   String?
  phone     String?
  active    Boolean   @default(true)
  version   Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  company   Company   @relation(fields:[companyId],references:[id],onDelete:Restrict)
  @@unique([id,companyId])
  @@index([companyId,deletedAt])
  @@map("branches")
}

model Permission {
  code        String @id
  description String
  grants      RolePermission[]
  rules       ApprovalRule[]
  @@map("permissions")
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  name        String
  description String?
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy   String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  company     Company   @relation(fields:[companyId],references:[id],onDelete:Restrict)
  grants      RolePermission[]
  memberships UserCompanyRole[]
  @@unique([id,companyId])
  @@map("roles")
}

model RolePermission {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  permissionCode String   @map("permission_code")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?  @map("created_by") @db.Uuid
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy      String?  @map("updated_by") @db.Uuid
  company        Company @relation(fields:[companyId],references:[id],onDelete:Restrict)
  role           Role    @relation(fields:[roleId,companyId],references:[id,companyId],onDelete:Restrict)
  permission     Permission @relation(fields:[permissionCode],references:[code],onDelete:Restrict)
  @@unique([companyId,roleId,permissionCode])
  @@map("role_permissions")
}

model UserCompanyRole {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid
  company   Company @relation(fields:[companyId],references:[id],onDelete:Restrict)
  role      Role    @relation(fields:[roleId,companyId],references:[id,companyId],onDelete:Restrict)
  user      User    @relation(fields:[userId],references:[id],onDelete:Restrict)
  @@unique([companyId,userId,roleId])
  @@index([userId,companyId])
  @@map("user_company_roles")
}

model FiscalYear {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  name      String
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime  @map("end_date") @db.Date
  isClosed  Boolean   @default(false) @map("is_closed")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  company   Company   @relation(fields:[companyId],references:[id],onDelete:Restrict)
  periods   Period[]
  sequences Sequence[]
  journalEntries JournalEntry[]
  @@unique([id,companyId])
  @@map("fiscal_years")
}

model Period {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  fiscalYearId String    @map("fiscal_year_id") @db.Uuid
  name         String
  startDate    DateTime  @map("start_date") @db.Date
  endDate      DateTime  @map("end_date") @db.Date
  isClosed     Boolean   @default(false) @map("is_closed")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?   @map("created_by") @db.Uuid
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy    String?   @map("updated_by") @db.Uuid
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  company      Company   @relation(fields:[companyId],references:[id],onDelete:Restrict)
  fiscalYear   FiscalYear @relation(fields:[fiscalYearId,companyId],references:[id,companyId],onDelete:Restrict)
  @@unique([id,companyId])
  @@map("periods")
}

model NumberSeries {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  docType   String    @map("doc_type")
  prefix    String
  format    String
  padding   Int
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  company   Company   @relation(fields:[companyId],references:[id],onDelete:Restrict)
  sequences Sequence[]
  @@unique([id,companyId])
  @@map("number_series")
}

model Sequence {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  seriesId     String    @map("series_id") @db.Uuid
  docType      String    @map("doc_type")
  fiscalYearId String    @map("fiscal_year_id") @db.Uuid
  prefix       String
  format       String
  padding      Int
  nextNumber   BigInt    @default(1) @map("next_number")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?   @map("created_by") @db.Uuid
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy    String?   @map("updated_by") @db.Uuid
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  company      Company   @relation(fields:[companyId],references:[id],onDelete:Restrict)
  series       NumberSeries @relation(fields:[seriesId,companyId],references:[id,companyId],onDelete:Restrict)
  fiscalYear   FiscalYear @relation(fields:[fiscalYearId,companyId],references:[id,companyId],onDelete:Restrict)
  @@map("sequences")
}

model ApprovalRule {
  id                     String    @id @default(uuid()) @db.Uuid
  companyId              String    @map("company_id") @db.Uuid
  docType                String    @map("doc_type")
  action                 String
  approverPermissionCode String    @map("approver_permission_code")
  thresholdAmount        Decimal?  @map("threshold_amount") @db.Decimal(18,4)
  active                 Boolean   @default(true)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy              String?   @map("created_by") @db.Uuid
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy              String?   @map("updated_by") @db.Uuid
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz(6)
  company                Company   @relation(fields:[companyId],references:[id],onDelete:Restrict)
  permission             Permission @relation(fields:[approverPermissionCode],references:[code],onDelete:Restrict)
  approvals              Approval[]
  @@unique([id,companyId])
  @@map("approval_rules")
}

model Approval {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  ruleId         String    @map("rule_id") @db.Uuid
  docType        String    @map("doc_type")
  docId          String    @map("doc_id") @db.Uuid
  action         String
  operationKey   String    @map("operation_key") @db.Uuid
  requestedBy    String    @map("requested_by") @db.Uuid
  requestedAt    DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  status         String    @default("PENDING")
  requestNote    String?   @map("request_note")
  requestData    Json      @map("request_data")
  targetVersion  Int       @map("target_version")
  ruleSnapshot   Json      @map("rule_snapshot")
  decidedBy      String?   @map("decided_by") @db.Uuid
  decidedAt      DateTime? @map("decided_at") @db.Timestamptz(6)
  decisionNote   String?   @map("decision_note")
  executedAt     DateTime? @map("executed_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  company        Company   @relation(fields:[companyId],references:[id],onDelete:Restrict)
  rule           ApprovalRule @relation(fields:[ruleId,companyId],references:[id,companyId],onDelete:Restrict)
  requester      User      @relation("Requester",fields:[requestedBy],references:[id],onDelete:Restrict)
  decider        User?     @relation("Decider",fields:[decidedBy],references:[id],onDelete:Restrict)
  @@unique([companyId,operationKey])
  @@index([companyId,status,requestedAt])
  @@map("approvals")
}

model Attachment {
  id         String    @id @default(uuid()) @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  docType    String    @map("doc_type")
  docId      String    @map("doc_id") @db.Uuid
  filePath   String    @map("file_path")
  name       String
  size       BigInt
  mime       String
  checksum   String
  uploadedBy String    @map("uploaded_by") @db.Uuid
  expiresAt  DateTime? @map("expires_at") @db.Date
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String?   @map("created_by") @db.Uuid
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy  String?   @map("updated_by") @db.Uuid
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)
  company    Company   @relation(fields:[companyId],references:[id],onDelete:Restrict)
  uploader   User      @relation(fields:[uploadedBy],references:[id],onDelete:Restrict)
  @@unique([id,companyId])
  @@index([companyId,docType,docId])
  @@map("attachments")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String?  @map("company_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  tableName  String   @map("table_name")
  recordId   String?  @map("record_id") @db.Uuid
  beforeJson Json?    @map("before_json")
  afterJson  Json?    @map("after_json")
  ip         String?  @db.VarChar(45)
  device     String?
  requestId  String   @map("request_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  company    Company? @relation(fields:[companyId],references:[id],onDelete:Restrict)
  user       User?    @relation(fields:[userId],references:[id],onDelete:Restrict)
  @@index([companyId,createdAt])
  @@index([companyId,tableName,recordId])
  @@map("audit_logs")
}

model Department {
  id String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  code String
  name String
  active Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String? @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String? @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  company Company @relation(fields:[companyId],references:[id],onDelete:Restrict)
  lines JournalLine[]
  invoiceLines InvoiceLine[]
  billLines BillLine[]
  payments Payment[]
  @@unique([id,companyId])
  @@index([companyId,deletedAt])
  @@map("departments")
}

model Account {
  id String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  code String
  name String
  type String
  parentId String? @map("parent_id") @db.Uuid
  isGroup Boolean @default(false) @map("is_group")
  isBank Boolean @default(false) @map("is_bank")
  isCash Boolean @default(false) @map("is_cash")
  active Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String? @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String? @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  company Company @relation(fields:[companyId],references:[id],onDelete:Restrict)
  parent Account? @relation("AccountTree",fields:[parentId,companyId],references:[id,companyId],onDelete:Restrict)
  children Account[] @relation("AccountTree")
  lines JournalLine[]
  invoiceLines InvoiceLine[]
  billLines BillLine[]
  payments Payment[]
  receivableSettings AccountingSettings[] @relation("Receivable")
  payableSettings AccountingSettings[] @relation("Payable")
  openingSettings AccountingSettings[] @relation("Opening")
  @@unique([id,companyId])
  @@index([companyId,parentId])
  @@map("accounts")
}

model Party {
  id String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  code String
  name String
  companyName String? @map("company_name")
  phone String?
  email String?
  city String?
  ntn String?
  address String?
  creditDays Int @default(0) @map("credit_days")
  isCustomer Boolean @default(true) @map("is_customer")
  isSupplier Boolean @default(false) @map("is_supplier")
  isExhibitor Boolean @default(false) @map("is_exhibitor")
  isSponsor Boolean @default(false) @map("is_sponsor")
  isStaff Boolean @default(false) @map("is_staff")
  active Boolean @default(true)
  openingBalance Decimal @default(0) @map("opening_balance") @db.Decimal(18,4)
  openingSide String @default("RECEIVABLE") @map("opening_side")
  openingEntryId String? @map("opening_entry_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String? @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String? @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  company Company @relation(fields:[companyId],references:[id],onDelete:Restrict)
  openingEntry JournalEntry? @relation("PartyOpening",fields:[openingEntryId,companyId],references:[id,companyId],onDelete:Restrict)
  lines JournalLine[]
  invoices Invoice[]
  bills Bill[]
  payments Payment[]
  @@unique([id,companyId])
  @@index([companyId,deletedAt])
  @@map("parties")
}

model Journal {
  id String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  code String
  name String
  type String
  active Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String? @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String? @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  company Company @relation(fields:[companyId],references:[id],onDelete:Restrict)
  entries JournalEntry[]
  salesSettings AccountingSettings[] @relation("SalesJournal")
  purchaseSettings AccountingSettings[] @relation("PurchaseJournal")
  generalSettings AccountingSettings[] @relation("GeneralJournal")
  cashSettings AccountingSettings[] @relation("CashJournal")
  bankSettings AccountingSettings[] @relation("BankJournal")
  @@unique([id,companyId])
  @@index([companyId,deletedAt])
  @@map("journals")
}

model JournalEntry {
  id String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  journalId String @map("journal_id") @db.Uuid
  fiscalYearId String? @map("fiscal_year_id") @db.Uuid
  number String?
  date DateTime @db.Date
  kind String @default("JOURNAL")
  narration String?
  status String @default("DRAFT")
  sourceType String @map("source_type")
  sourceId String @map("source_id") @db.Uuid
  reversalOfId String? @map("reversal_of_id") @db.Uuid
  version Int @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String? @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String? @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  company Company @relation(fields:[companyId],references:[id],onDelete:Restrict)
  journal Journal @relation(fields:[journalId,companyId],references:[id,companyId],onDelete:Restrict)
  fiscalYear FiscalYear? @relation(fields:[fiscalYearId,companyId],references:[id,companyId],onDelete:Restrict)
  reversalOf JournalEntry? @relation("EntryReversal",fields:[reversalOfId,companyId],references:[id,companyId],onDelete:Restrict)
  reversals JournalEntry[] @relation("EntryReversal")
  lines JournalLine[]
  invoices Invoice[] @relation("InvoiceEntry")
  cancelledInvoices Invoice[] @relation("InvoiceReversal")
  bills Bill[] @relation("BillEntry")
  cancelledBills Bill[] @relation("BillReversal")
  payments Payment[] @relation("PaymentEntry")
  cancelledPayments Payment[] @relation("PaymentReversal")
  partyOpenings Party[] @relation("PartyOpening")
  @@unique([id,companyId])
  @@unique([companyId,number])
  @@unique([companyId,sourceType,sourceId])
  @@unique([companyId,reversalOfId])
  @@index([companyId,date,status])
  @@map("journal_entries")
}

model JournalLine {
  id String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  entryId String @map("entry_id") @db.Uuid
  accountId String @map("account_id") @db.Uuid
  lineNo Int @map("line_no")
  debit Decimal @default(0) @db.Decimal(18,4)
  credit Decimal @default(0) @db.Decimal(18,4)
  partyId String? @map("party_id") @db.Uuid
  // Event/outlet FKs are deliberately added when those modules create their tables.
  eventId String? @map("event_id") @db.Uuid
  outletId String? @map("outlet_id") @db.Uuid
  departmentId String? @map("department_id") @db.Uuid
  memo String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String? @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String? @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  company Company @relation(fields:[companyId],references:[id],onDelete:Restrict)
  entry JournalEntry @relation(fields:[entryId,companyId],references:[id,companyId],onDelete:Restrict)
