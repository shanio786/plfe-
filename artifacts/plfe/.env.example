# Copy to .env in the repository root or application directory.
DATABASE_URL=postgresql://plfe_app:CHANGE_ME@127.0.0.1:5432/plfe?schema=public
# Direct deployment: store the real migration URL in operator-only .env.maintenance.
# Only db:migrate/db:seed load that file; application and worker must not read it.
MIGRATION_DATABASE_URL=
TEST_DATABASE_URL=
# Optional development-only override; leave unset on the VPS.
# PLFE_DATABASE_URL=
APP_URL=https://portal.example.com
PORT=3000
APP_HOST=0.0.0.0
ACCOUNTING_TIMEZONE=Asia/Karachi
NODE_ENV=production
SESSION_COOKIE_NAME=__Host-plfe-session
PASSWORD_MIN_LENGTH=10
BCRYPT_ROUNDS=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
SESSION_IDLE_MINUTES=240
SESSION_MAX_MINUTES=840
UPLOAD_DIR=./var/uploads
MAX_UPLOAD_BYTES=10485760
UPLOAD_ALLOWED_MIME=application/pdf,image/jpeg,image/png,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/plain
WORKER_CLEANUP_CRON=*/15 * * * *
# App-only first-run credential, at least 43 base64url characters from 32 random bytes.
# Supply privately, use once at /enroll, then remove from the app environment.
BOOTSTRAP_ENROLLMENT_TOKEN=
# Optional restriction to the authorized operator's exact email.
BOOTSTRAP_OWNER_EMAIL=
# Docker PostgreSQL initialisation; use the same password in DATABASE_URL.
POSTGRES_DB=plfe
POSTGRES_USER=plfe
POSTGRES_PASSWORD=
