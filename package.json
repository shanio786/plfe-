{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/install-app.mjs",
    "build": "npm --prefix artifacts/plfe run build",
    "start": "npm --prefix artifacts/plfe start",
    "dev": "npm --prefix artifacts/plfe run dev",
    "db:migrate": "npm --prefix artifacts/plfe run db:migrate",
    "db:seed": "npm --prefix artifacts/plfe run db:seed",
    "worker": "npm --prefix artifacts/plfe run worker",
    "test:phase1": "npm --prefix artifacts/plfe test",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "~5.9.3"
  }
}
