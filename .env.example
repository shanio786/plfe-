# Deployment/security configuration only. Business settings live in PostgreSQL.
# Copy to .env. Never commit real credentials.
DATABASE_URL=postgresql://plfe_app:CHANGE_ME@127.0.0.1:5432/plfe?schema=public
# Compose reads this on the host but does not pass it to app/worker.
# For direct Node deployment put the real value in operator-owned .env.maintenance,
# NOT in the runtime .env. Only db:migrate/db:seed load .env.maintenance.
MIGRATION_DATABASE_URL=
# Optional separate throwaway database for automated tests, ending in _test.
TEST_DATABASE_URL=
# Docker: replace 127.0.0.1 in DATABASE_URL with postgres.
APP_URL=https://portal.example.com
PORT=3000
APP_HOST=0.0.0.0
ACCOUNTING_TIMEZONE=Asia/Karachi
NODE_ENV=production
SESSION_COOKIE_NAME=__Host-plfe-session
PASSWORD_MIN_LENGTH=10
BCRYPT_ROUNDS=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
SESSION_IDLE_MINUTES=240
SESSION_MAX_MINUTES=840
UPLOAD_DIR=./var/uploads
MAX_UPLOAD_BYTES=10485760
UPLOAD_ALLOWED_MIME=application/pdf,image/jpeg,image/png,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/plain
WORKER_CLEANUP_CRON=*/15 * * * *
SEED_OWNER_EMAIL=
SEED_OWNER_NAME=
SEED_OWNER_PASSWORD=
SEED_TEST_EMAIL=
SEED_TEST_PASSWORD=
POSTGRES_DB=plfe
POSTGRES_USER=plfe
POSTGRES_PASSWORD=
# Optional local-preview-only connection override. Leave unset on the VPS.
# PLFE_DATABASE_URL=
